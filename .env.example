# Vercel environments: pull the real values with `npx vercel env pull` (writes .env.local; never commit .env files).
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Blob store (OIDC): BLOB_STORE_ID, VERCEL_OIDC_TOKEN, BLOB_WEBHOOK_PUBLIC_KEY are set by the store connection.
# Spike only (ST-001), removed by ST-066:
SPIKE_PASSWORD=

# Local development: `npm run db:up` starts PostgreSQL (docker-compose.yml), `npm run db:migrate:dev` migrates it.
# Put local-only values into .env.development.local – `vercel env pull` overwrites .env.local, not that file:
#   DATABASE_URL=postgres://laguardia:laguardia@localhost:5433/laguardia
#   SPIKE_PASSWORD=local
