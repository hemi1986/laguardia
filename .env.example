# Vercel environments: pull the real values with `npx vercel env pull` (writes .env.local; never commit .env files).
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Object store (ST-099, ADR 0012): AWS S3 in eu-central-1 on Vercel, through an IAM role assumed with Vercel's OIDC
# token – no access key. Set up once by hand: docs/operations/aws-s3-setup.md.
S3_BUCKET=
S3_REGION=eu-central-1
AWS_ROLE_ARN=
# Team login (ST-004, Better Auth): a random secret per environment, e.g. `openssl rand -base64 32`.
# Changing it logs everybody out. BETTER_AUTH_URL is optional (derived from the Vercel URL / localhost).
BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://…

# Local development: `npm run db:up` starts PostgreSQL (docker-compose.yml), `npm run db:migrate:dev` migrates it.
# Put local-only values into .env.development.local – `vercel env pull` overwrites .env.local, not that file:
#   DATABASE_URL=postgres://laguardia:laguardia@localhost:5433/laguardia
# `npm run db:up` starts SeaweedFS too (S3 on localhost:8333, the buckets laguardia-dev, laguardia-e2e, laguardia-test)
# with a fixed development identity that means nothing outside this machine – the dev server's bucket:
#   S3_ENDPOINT=http://localhost:8333
#   S3_REGION=us-east-1
#   S3_BUCKET=laguardia-dev
#   S3_ACCESS_KEY_ID=laguardia-dev
#   S3_SECRET_ACCESS_KEY=laguardia-dev-secret
#
# Tests (ST-059): integration tests use TEST_DATABASE_URL, never DATABASE_URL; each run drops and re-migrates it.
# Default: postgres://laguardia:laguardia@localhost:5433/laguardia_test (created on first run). The S3 adapter's tests
# use the bucket laguardia-test on the local SeaweedFS (TEST_S3_* to point elsewhere, as CI does).
#
# Local browser tests (ST-083): `npm run test:e2e` starts a dev server of their own on port 3100 (distDir .next-e2e)
# against laguardia_e2e_test on the same PostgreSQL – created if missing and reset on every run, with the e2e
# technician below created automatically; their uploads go to the bucket laguardia-e2e on the local SeaweedFS, emptied
# of the previous run's uploads at the start. The development database (DATABASE_URL) is never touched by tests, and a
# dev server on port 3000 keeps running. `npm run db:up` is the only preparation. BASE_URL
# (+ VERCEL_AUTOMATION_BYPASS_SECRET) points the tests at a preview instead – no local database, no local server.
# The e2e technician (put into .env.development.local; without them the team-page tests skip):
#   E2E_TEAM_USERNAME=e2e_tech
#   E2E_TEAM_PASSWORD=          (at least 10 characters)
#
# First technician of your own development database (ST-004): `npm run setup:first-technician` – asks for name,
# username and password.
