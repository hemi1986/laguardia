# Template of the one local settings file: `cp .env.example .env.development.local`, then fill in the three empty values.
# Read by `npm run dev`, the local browser tests and the scripts; never committed. Previews and production get their
# values in the Vercel dashboard, not from a file – the list is in README.md ("Environment variables").

# PostgreSQL from docker-compose.yml (`npm run db:up`, then `npm run db:migrate:dev`)
DATABASE_URL=postgres://laguardia:laguardia@localhost:5433/laguardia

# Team login (Better Auth): any random secret, e.g. `openssl rand -base64 32` – changing it logs everybody out
BETTER_AUTH_SECRET=

# AI settings (ST-104, ADR 0014): the key that encrypts the saved OpenRouter key – 32 random bytes, base64, e.g.
# `openssl rand -base64 32`. Changing or losing it only loses the saved OpenRouter key; a technician enters it again.
AI_SETTINGS_ENCRYPTION_KEY=

# Object store: SeaweedFS from docker-compose.yml with its fixed development identity (only valid on this machine)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=laguardia-dev
S3_ACCESS_KEY_ID=laguardia-dev
S3_SECRET_ACCESS_KEY=laguardia-dev-secret

# The technician the local browser tests log in as – created automatically on every run (password ≥ 10 characters);
# without them the team-page tests skip
E2E_TEAM_USERNAME=e2e_tech
E2E_TEAM_PASSWORD=
